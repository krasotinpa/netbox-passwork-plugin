# Local settings for scripts/test.sh — copy to .env (git-ignored) and adjust for your machine.
NETBOX_ROOT=/opt/netbox
# NETBOX_VENV=/opt/netbox/venv
# NetBox configuration module with the plugin registered (PLUGINS=['netbox_passwork'] + PLUGINS_CONFIG)
NETBOX_CONFIGURATION=netbox.configuration
# Linux node build for the JS tests (needed when node is missing from PATH, or PATH has a Windows node under WSL)
# NODE_BIN=/usr/bin/node
